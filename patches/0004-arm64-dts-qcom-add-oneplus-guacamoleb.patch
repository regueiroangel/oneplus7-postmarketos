From 589082fb88e74579b101f95807289955e03c6e12 Mon Sep 17 00:00:00 2001
From: postmarketOS port <angelregueirovigo@gmail.com>
Date: Sun, 8 Nov 2026 17:01:00 +0100
Subject: [PATCH] arm64: dts: qcom: add OnePlus 7 (guacamoleb)

---
 arch/arm64/boot/dts/qcom/Makefile             |   1 +
 .../dts/qcom/sm8150-oneplus-guacamoleb.dts    | 108 ++++++++++++++++++
 2 files changed, 109 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamoleb.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 2121fd8..fc6e964 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -314,6 +314,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-xiaomi-vayu-tianma.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-xiaomi-vayu-huaxing.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-oneplus-guacamole.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-oneplus-guacamoleb.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8150-oneplus-hotdogb.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8250-samsung-r8q.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamoleb.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamoleb.dts
new file mode 100644
index 0000000..7109a43
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamoleb.dts
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Devicetree for the OnePlus 7 (guacamoleb, GM1900/GM1901/GM1903/GM1905).
+ * Shares the board with the OnePlus 7 Pro (guacamole) but has a
+ * 1080x2340 panel. Touchscreen is left disabled (headless bring-up).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "sm8150-oneplus-common.dtsi"
+
+/ {
+	model = "OnePlus 7";
+	compatible = "oneplus,guacamoleb", "oneplus,oneplus7", "qcom,sm8150";
+
+	/*
+	 * Required by the stock ABL to pick this DTB (SM8150 v2, board-id
+	 * 0 0 as in the stock OxygenOS SoC dtbs). dtbo must be erased.
+	 */
+	qcom,msm-id = <339 0x20000>;
+	qcom,board-id = <0 0>;
+
+	aliases {
+		display0 = &framebuffer0;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		stdout-path = "display0";
+
+		/*
+		 * hack: Use framebuffer setup by the bootloader for simplefb.
+		 * Same bootloader reserved address as the rest of the series.
+		 */
+		framebuffer0: framebuffer@9c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x9c000000 0 (1080 * 2340 * 4)>;
+			width = <1080>;
+			height = <2340>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+			status = "okay";
+		};
+	};
+
+	/*
+	 * 3700 mAh pack. Float voltage is capped at 4.1 V and charge current at
+	 * 1 A on purpose: this device is meant to sit on a charger 24/7 as a
+	 * server, so keep the cell well below full to limit swelling.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <3700000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4400000>;
+		constant-charge-voltage-max-microvolt = <4100000>;
+		constant-charge-current-max-microamp = <1000000>;
+	};
+
+	reserved-memory {
+		/* hack: Bootloader framebuffer memory region */
+		fb_mem: memory@9c000000 {
+			compatible = "removed-dma-pool";
+			no-map;
+			reg = <0 0x9c000000 0 (1080 * 2340 * 4)>;
+		};
+	};
+};
+
+&wifi {
+	vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
+	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
+	vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
+	vdd-3.3-ch0-supply = <&vreg_l11c_3p3>;
+
+};
+
+&pm8150b_charger {
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
+&pm8150b_fg {
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8150b_charger>;
+	status = "okay";
+};
+
+/*
+ * The boot firmware arms a download-mode cookie in TCSR; unless the SCM
+ * driver can clear it directly, any unclean reset (e.g. a modem crash during
+ * shutdown) ends in Qualcomm crash-dump mode instead of rebooting.
+ * From the OnePlus 7 Pro / 7T Pro mainline bring-ups.
+ */
+&scm {
+	qcom,dload-mode = <&tcsr 0x13000>;
+};
+
+&{/soc@0} {
+	tcsr: syscon@1fc0000 {
+		compatible = "qcom,sm8150-tcsr", "syscon";
+		reg = <0x0 0x01fc0000 0x0 0x30000>;
+	};
+};
-- 
